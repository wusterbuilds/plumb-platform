{
  "_comment": "Google OAuth client credentials for the Gmail integration. Download this file from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs > Desktop app. Save the real file as credentials.json (which is gitignored). Then run scripts/gmail_oauth_setup.py to mint token.json. Required scopes: gmail.readonly, gmail.send, gmail.modify.",
  "installed": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "project_id": "your-google-cloud-project-id",
    "auth_uri": "https://accounts.google.com/o/oauth2/auth",
    "token_uri": "https://oauth2.googleapis.com/token",
    "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
    "client_secret": "YOUR_CLIENT_SECRET",
    "redirect_uris": ["http://localhost"]
  }
}
