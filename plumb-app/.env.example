# Database
DATABASE_URL=postgresql+asyncpg://plumb:plumb_dev@localhost:5432/plumb

# Redis
REDIS_URL=redis://localhost:6379/0

# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=plumb
S3_SECRET_KEY=plumb_dev_key
S3_BUCKET_NAME=plumb-documents
S3_REGION=us-east-1

# Auth
JWT_SECRET=change-me-in-production-use-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Anthropic — required. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Brave Search — used by the research / news fetcher.
# https://brave.com/search/api/  (optional; agent gracefully degrades without it)
BRAVE_API_KEY=your-brave-api-key-here

# Gmail (email integration for demo). Off by default. To enable the
# inbound-email demo flow:
#   1. Set GMAIL_ENABLED=true
#   2. Drop your Google OAuth client at the path in GMAIL_CREDENTIALS_JSON
#      (see credentials.json.example for shape)
#   3. Run scripts/gmail_oauth_setup.py to mint token.json
GMAIL_CREDENTIALS_JSON=credentials.json
GMAIL_TOKEN_JSON=token.json
GMAIL_MONITORED_ADDRESS=your-demo-inbox@example.com
GMAIL_LABEL=plumb-deals
GMAIL_POLL_INTERVAL_SECONDS=30
GMAIL_ENABLED=false

# Optional synthetic demo fixtures. Do not point these at customer data.
PLUMB_DEMO_SCENARIO_DIR=
PLUMB_DEMO_FIRST_PASS_DIR=
PLUMB_DEMO_SECOND_PASS_DIR=
